# Copiar a .env (local) o definir en la plataforma (pruebas/producción).
# En local, config/settings/local.py ya da valores por defecto; .env solo sobrescribe.

# Obligatorias en pruebas y producción
DJANGO_SETTINGS_MODULE=config.settings.produccion
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DATABASE_URL=postgres://usuario:clave@servidor:5432/todocargo
ALLOWED_HOSTS=todocargo-pruebas.onrender.com
CSRF_TRUSTED_ORIGINS=https://todocargo-pruebas.onrender.com

# Opcionales
DEBUG=False
CLAVE_ACCESO=clave-compartida-para-probadores
LOG_LEVEL=INFO
